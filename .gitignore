# Los datos son regenerables desde las APIs y pesados para un repo.
data/*
!data/raw/
data/raw/*
!data/processed/
data/processed/*
!data/processed/registro_clima.json

# Excepcion: el manifiesto de descargas es el registro de reproducibilidad
# del proyecto. Si no se versiona, no hay forma de reconstruir despues que
# datos habia en cada momento, que es justo para lo que existe.
!data/raw/manifiesto.json

# Misma razon para el registro de limpieza: es lo que permite responder
# despues de donde salio cada valor.
!data/procesado/
data/procesado/*
!data/procesado/registro_limpieza.json

# datasets/: cientos de MB de CSV regenerables con scripts/descargar_datasets.py.
# Se versionan solo el README y el manifiesto, que dice que se genero, cuando y
# con que hash, por la misma razon que los otros dos manifiestos.
datasets/*
!datasets/README.md
!datasets/manifiesto_datasets.json

# datasets/limpios/: salidas de los notebooks de limpieza. Los datos no; los
# registros de limpieza si, porque son los que dicen de donde salio cada valor.
!datasets/limpios/
datasets/limpios/*
!datasets/limpios/registro_*.json

__pycache__/
*.pyc
.pytest_cache/
.venv/
