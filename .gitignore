# Los datos son regenerables desde las APIs y pesados para un repo.
data/*
!data/raw/
data/raw/*
!data/processed/
data/processed/*
!data/processed/registro_clima.json

# Excepcion: el manifiesto de descargas es el registro de reproducibilidad
# del proyecto. Si no se versiona, no hay forma de reconstruir despues que
# datos habia en cada momento, que es justo para lo que existe.
!data/raw/manifiesto.json

# Misma razon para el registro de limpieza y el de variables: son los que
# permiten responder despues de donde salio cada valor y cada columna.
!data/procesado/
data/procesado/*
!data/procesado/registro_limpieza.json
!data/procesado/registro_variables.json

# datasets/: cientos de MB de CSV regenerables con scripts/descargar_datasets.py.
# Se versionan solo el README y el manifiesto, que dice que se genero, cuando y
# con que hash, por la misma razon que los otros dos manifiestos.
datasets/*
!datasets/README.md
!datasets/manifiesto_datasets.json

# datasets/limpios/: salidas de los notebooks de limpieza. Los datos no; los
# registros de limpieza si, porque son los que dicen de donde salio cada valor.
!datasets/limpios/
datasets/limpios/*
!datasets/limpios/registro_*.json

__pycache__/
*.pyc
.pytest_cache/
.venv/

# Informe LaTeX: se versionan la fuente, lo generado y el PDF; no los auxiliares.
docs/informe/*.aux
docs/informe/*.log
docs/informe/*.out
docs/informe/*.fls
docs/informe/*.fdb_latexmk
docs/informe/*.synctex.gz

# Terraform: estado, planes y variables locales nunca van al repositorio.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
infra/terraform/terraform.tfvars
infra/terraform/backend.tf
# Salidas sin redactar (ID de cuenta, correo): la version publicada va redactada.
infra/terraform/evidencia/**/*_sin_redactar.*

# Modelos entrenados: pesados y regenerables. Su SHA-256 queda anotado en
# docs/resultados/modelado_*.json, que si se versiona.
models/

# app/datos/: lo que exporta scripts/exportar_interfaz.py para la interfaz. Si se
# versiona a proposito, aunque sea Parquet: la app desplegada (Streamlit Community
# Cloud) solo ve lo que esta en git, y el panel del que sale no lo esta.
!app/datos/
!app/datos/*.parquet
!app/datos/manifiesto_interfaz.json
app/datos/*.tmp
